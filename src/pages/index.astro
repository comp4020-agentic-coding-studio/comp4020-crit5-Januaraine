---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DVD Logo Breakout</title>
    <meta
      name="description"
      content="A pixel-style DVD-logo screensaver turned into a Breakout game: keep the bouncing logo off the floor with your paddle."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">DVD Logo Breakout</h1>
      <div class="game-wrapper">
        <canvas
          id="game"
          aria-label="DVD logo breakout game. Move the paddle with A/D, arrow keys, your mouse, or by dragging on the screen. Keep the bouncing DVD logo from falling past the paddle. Reach a top corner to win."
        ></canvas>
        <div id="mode-select" class="game-over mode-select">
          <p>DVD Logo</p>
          <div class="select-group" role="group" aria-label="Game mode">
            <p class="select-label">Game Mode</p>
            <div class="mode-buttons">
              <button id="select-normal" type="button" aria-pressed="true">Normal Mode</button>
              <button id="select-endless" type="button" aria-pressed="false">Endless Mode</button>
            </div>
          </div>
          <div class="select-group" role="group" aria-label="Difficulty">
            <p class="select-label">Difficulty</p>
            <div class="mode-buttons">
              <button id="select-easy" type="button" aria-pressed="true">Easy</button>
              <button id="select-hard" type="button" aria-pressed="false">Hard</button>
            </div>
          </div>
          <button id="start-game" type="button" class="start-button">Start</button>
        </div>
        <div id="game-over" class="game-over" hidden>
          <p>Game Over</p>
          <p class="score-line">CATCHES: <span id="game-over-catches">0</span></p>
          <p class="score-line" id="game-over-corners-line" hidden>CORNERS: <span id="game-over-corners">0</span></p>
          <p class="score-line">BEST: <span id="game-over-best">—</span></p>
          <div class="pause-buttons">
            <button id="restart" type="button">Play Again</button>
            <button id="game-over-change-mode" type="button">Change Mode</button>
          </div>
        </div>
        <div id="game-win" class="game-over game-win" hidden>
          <p>You Win!</p>
          <p class="score-line">CATCHES: <span id="game-win-catches">0</span></p>
          <p class="score-line">BEST: <span id="game-win-best">—</span></p>
          <div class="pause-buttons">
            <button id="restart-win" type="button">Play Again</button>
            <button id="win-change-mode" type="button">Change Mode</button>
          </div>
        </div>
        <div id="game-paused" class="game-over game-paused" hidden>
          <p>Paused</p>
          <div class="pause-buttons">
            <button id="pause-continue" type="button">Continue</button>
            <button id="pause-restart" type="button">Restart</button>
            <button id="pause-change-mode" type="button">Change Mode</button>
          </div>
        </div>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
